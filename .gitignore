*.doc
*.epub
*.mobi
*.azw3
*.kpf
*.odt
*.rtf
*.pages
*.tex
*.idml
# Las figuras del libro no se publican: los programas las dibujan en figuras/ al ejecutarse; viven en el repositorio privado.
*.png
*.jpg
*.jpeg
*.svg
*.gif
!figuras/.gitkeep
